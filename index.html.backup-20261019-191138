<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#ff68b4"><title>Candy Pop Adventure</title>
<style>
:root{--pink:#ff68b4;--ink:#71305f}*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}body{margin:0;font-family:system-ui,sans-serif;background:linear-gradient(#71ddff,#e0fbff 48%,#82e18a);color:var(--ink);user-select:none}button{font:inherit;cursor:pointer;touch-action:manipulation}.app{max-width:540px;min-height:100dvh;margin:auto;padding-bottom:78px;overflow:hidden;background:linear-gradient(#71ddff,#e0fbff 48%,#82e18a)}.top{display:flex;align-items:center;justify-content:space-between;padding:10px;background:linear-gradient(#ffc5e5,#ff82c5);border-bottom:4px solid #e34b9d;border-radius:0 0 22px 22px}.pill,.round{border:3px solid #fff4fc;box-shadow:0 3px #d34191;background:linear-gradient(#fff,#ffe2f2);border-radius:22px;color:#8b2c67;font-weight:900;padding:8px}.round{width:43px;height:43px;padding:0;font-size:23px}.brand{text-align:center;font-weight:1000;font-size:15px}.brand small{display:block;font-size:9px;letter-spacing:1.5px}.map{text-align:center}.castle{font-size:65px}.world{height:clamp(370px,53vh,550px);position:relative;background:radial-gradient(ellipse,#e4ffad,#86e17d 70%,#43bb6b);border-radius:48% 48% 0 0/8% 8% 0 0;border-top:8px solid #fff6a4;overflow:hidden}.path{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.path path{fill:none;stroke:#fff2f9;stroke-width:25;stroke-linecap:round}.path .pink{stroke:#ff70c1;stroke-width:17;stroke-dasharray:4 5}.island{position:absolute;font-size:36px}.i1{left:4%;top:13%}.i2{right:3%;top:42%}.node{position:absolute;width:54px;height:54px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(#ffb6e2,#ff4fa6);border:5px solid #fff2fa;box-shadow:0 5px #c33c8a;color:white;font-weight:1000}.n1{left:43%;bottom:2%;background:linear-gradient(#ffe8a0,#ffb92d)}.n2{left:25%;bottom:24%;background:linear-gradient(#ffe8a0,#ffb92d)}.n3{left:53%;bottom:47%}.n4{left:67%;bottom:68%}.n5{left:40%;bottom:85%}.mascot{position:absolute;right:8%;bottom:12%;font-size:56px}.caption{color:white;text-shadow:0 2px 3px #347d72;padding:10px 14px 18px}.caption h1{font-size:23px;margin:0}.caption p{margin:3px 0 12px}.primary{border:3px solid white;border-radius:40px;padding:12px 22px;background:linear-gradient(#8dfb65,#39c834);box-shadow:0 5px #239c35;color:white;font-size:18px;font-weight:1000}.game{padding:12px;background:linear-gradient(#8be7ff,#e7fbff,#fff0f9)}.heading{display:flex;align-items:center;gap:9px}.heading h2{font-size:17px;margin:2px 0}.heading small,.box small{font-size:10px;font-weight:900;letter-spacing:1px}.box{margin-left:auto;text-align:center;background:white;border:3px solid #b8efff;border-radius:13px;padding:5px 9px;min-width:62px}.box strong{display:block;font-size:22px;color:#653a9c}.goal{display:flex;align-items:center;gap:9px;margin:12px 0;padding:8px;background:#fff9f2;border:3px solid white;border-radius:16px;box-shadow:0 4px #e9a5cf}.goal .emoji{font-size:30px}.goal small{display:block;font-size:11px}.boardwrap{background:linear-gradient(#bd86f5,#8b62d9);padding:6px;border:4px solid white;border-radius:18px;box-shadow:0 6px #6c43b1}.board{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:4px}.candy{aspect-ratio:1;border:0;border-radius:10px;display:grid;place-items:center;font-size:clamp(18px,6vw,30px);padding:0;background:linear-gradient(145deg,#ffffffbb,#ffffff18);box-shadow:inset 0 -4px #542c4b25,0 2px 2px #47206b33;min-width:0}.candy.sel{outline:4px solid #fff35c;transform:scale(.88)}.candy.special{outline:3px solid #fff9a6;box-shadow:0 0 9px #fff46b}.candy.rainbow{background:conic-gradient(#ff4f9b,#ffbd39,#fff65d,#55e78c,#48d7ff,#ad7aff,#ff4f9b);border:2px solid white}.hint{text-align:center;font-size:12px;font-weight:800;margin:12px 0;min-height:18px}.boost{display:flex;gap:5px}.boost button{flex:1;min-width:0;border:3px solid white;background:linear-gradient(white,#dff8ff);border-radius:14px;padding:5px 2px;box-shadow:0 3px #80cde7;color:#74439c;font-weight:900}.boost span{display:block;font-size:21px}.boost small{display:block;font-size:10px}.legend{text-align:center;font-size:11px;font-weight:800;color:#774b9b}.nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(100%,540px);height:74px;display:flex;background:linear-gradient(#ff9bd0,#ff69b4);border-top:4px solid #fff0fa;z-index:4}.nav button{flex:1;border:0;border-right:1px solid #ffffff55;background:transparent;color:#8b2b68;font-weight:900;display:flex;flex-direction:column;align-items:center;justify-content:center}.nav span{font-size:22px}.nav small{font-size:10px}.hidden{display:none!important}.modal{position:fixed;inset:0;z-index:10;background:#24113bbd;display:grid;place-items:center;padding:20px}.card{position:relative;width:min(100%,360px);max-height:85dvh;overflow:auto;text-align:center;background:linear-gradient(#fffaf5,#ffe7f4);border:7px solid #ff82c4;border-radius:30px;padding:24px 18px;box-shadow:0 8px #b63783}.card h2{margin:5px 0;color:#a32d76}.card p{color:#79465f;line-height:1.5;white-space:pre-line}.card .emoji{font-size:52px}.close{position:absolute;right:-12px;top:-15px;border:3px solid white;border-radius:50%;width:40px;height:40px;background:#ff4f63;color:white;font-size:25px}@media(max-width:360px){.game{padding:8px}.board{gap:3px}.boardwrap{padding:4px}.candy{border-radius:7px;font-size:clamp(16px,5.4vw,23px)}.boost span{font-size:19px}.brand{font-size:13px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style></head><body><div class="app">
<header class="top"><div class="pill">💗 <span id="lives">5</span> <button id="gift" style="border:0;background:transparent;color:inherit;font-weight:900">＋</button></div><div class="brand">🍭 CANDY POP<small>ADVENTURE · EPIC EDITION</small></div><button class="round" id="settings">⚙</button></header>
<main id="map" class="map"><div class="castle">🏰</div><section class="world"><div class="island i1">🍬<br>🏡</div><div class="island i2">🍭<br>🏠</div><svg class="path" viewBox="0 0 340 570" preserveAspectRatio="none"><path d="M168 540 C80 500 240 455 155 410 S90 330 180 285 S260 205 150 165 S110 90 170 35"/><path class="pink" d="M168 540 C80 500 240 455 155 410 S90 330 180 285 S260 205 150 165 S110 90 170 35"/></svg><div class="node n1" id="node1">1</div><div class="node n2" id="node2">2</div><div class="node n3" id="node3">3</div><div class="node n4" id="node4">4</div><div class="node n5" id="node5">5</div><div class="mascot">🍓</div></section><section class="caption"><h1>Sugarland Island</h1><p>Every sweet has a story!</p><button class="primary" id="play">PLAY LEVEL <span id="levelMap">1</span> ▶</button><p id="stats" style="font-size:12px;font-weight:900"></p></section></main>
<main id="game" class="game hidden"><div class="heading"><button class="round" id="back">‹</button><div><small>LEVEL <span id="level">1</span></small><h2>Collect the candy!</h2></div><div class="box"><small>MOVES</small><strong id="moves">25</strong></div></div><div class="goal"><span class="emoji">🍬</span><div style="flex:1"><b>Sweet collection</b><small>Collect <span id="goal">20</span> candies</small><div style="height:7px;background:#f3cce4;border-radius:8px;overflow:hidden;margin-top:5px"><div id="progress" style="height:100%;width:0;background:linear-gradient(90deg,#ff65af,#8cdb52)"></div></div></div><div class="box"><small>SCORE</small><strong id="score">0</strong></div></div><div class="boardwrap"><div id="board" class="board"></div></div><div id="hint" class="hint" aria-live="polite">Tap a candy, then an adjacent candy to swap.</div><div class="boost"><button id="shuffle"><span>🔀</span><small>Shuffle</small></button><button id="hintBtn"><span>💡</span><small>Hint</small></button><button id="power"><span>💥</span><small>Power</small></button><button id="sound"><span>🔊</span><small>Sound</small></button><button id="pause"><span>Ⅱ</span><small>Pause</small></button></div><p class="legend">✨ Match 4 for a blast · 🌈 Match 5 for a rainbow</p></main>
<nav class="nav"><button id="navMap"><span>🗺️</span><small>Map</small></button><button data-info="Goals"><span>📋</span><small>Goals</small></button><button data-info="Friends"><span>👯</span><small>Friends</small></button><button data-info="Collection"><span>🎖️</span><small>Collection</small></button><button data-info="Gifts"><span>🎁</span><small>Gifts</small></button></nav></div>
<div id="modal" class="modal hidden" role="dialog" aria-modal="true"><div class="card"><button class="close" id="close">×</button><div id="emoji" class="emoji">🍬</div><h2 id="title">Candy Pop</h2><p id="text"></p><button id="action" class="primary">OKAY</button></div></div>
<script>
(()=>{'use strict';const $=id=>document.getElementById(id),T=['🍓','🍋','🍇','🍬','🫐','🍊'],N=8,MAX=30;const db={get(k,d){try{return localStorage.getItem('cpa'+k)??d}catch(e){return d}},set(k,v){try{localStorage.setItem('cpa'+k,v)}catch(e){}}};let level=Math.max(1,+db.get('Level',db.get('Unlocked',1))||1),unlocked=Math.max(level,+db.get('Unlocked',level)||1),lives=Math.max(0,Math.min(5,+db.get('Lives',5))),best=+db.get('Best',0)||0,soundOn=db.get('Sound','on')!=='off',board=[],sel=null,moves=25,score=0,goal=20,collected=0,busy=false,paused=false,round=0;$('lives').textContent=lives;$('sound').querySelector('span').textContent=soundOn?'🔊':'🔇';const icon=v=>typeof v==='string'?v:(v&&v.icon)||'';const sleep=n=>new Promise(r=>setTimeout(r,n));function save(){db.set('Level',level);db.set('Unlocked',unlocked);db.set('Lives',lives);db.set('Best',best);db.set('Sound',soundOn?'on':'off')}function tone(f=500,d=.07){if(!soundOn)return;try{let C=AudioContext||webkitAudioContext,c=new C,o=c.createOscillator(),g=c.createGain();o.frequency.value=f;g.gain.value=.025;o.connect(g);g.connect(c.destination);o.start();o.stop(c.currentTime+d);o.onended=()=>c.close()}catch(e){}}function modal(t,p,e,a,fn){$('title').textContent=t;$('text').textContent=p;$('emoji').textContent=e;$('action').textContent=a;$('modal').classList.remove('hidden');$('action').onclick=()=>{$('modal').classList.add('hidden');fn&&fn()}}function closeModal(){$('modal').classList.add('hidden');if(paused){paused=false;$('pause').querySelector('small').textContent='Pause'}}$('close').onclick=closeModal;$('modal').onclick=e=>{if(e.target===$('modal'))closeModal()};$('settings').onclick=()=>modal('Settings',`Sound ${soundOn?'ON':'OFF'}. Progress is saved on this device. Offline single-player edition.`,'⚙️','OKAY');$('gift').onclick=()=>modal('Free life','Claim one free local life, up to five. No payment needed.','💗',lives<5?'CLAIM':'OKAY',()=>{if(lives<5){lives++;save();hud()}});$('play').onclick=start;$('back').onclick=()=>{if(!busy){$('game').classList.add('hidden');$('map').classList.remove('hidden');paused=false}};$('navMap').onclick=()=>$('back').click();document.querySelectorAll('[data-info]').forEach(b=>b.onclick=()=>{let k=b.dataset.info;if(k==='Goals')modal('Level goals',`Level ${level}\nCollect ${goal} candies.\nProgress ${collected}/${goal}\nBest ${best}`,'📋','OKAY');else if(k==='Collection')modal('Candy collection','🍓 Strawberry · 🍋 Lemon · 🍇 Grape · 🍬 Sweet · 🫐 Berry · 🍊 Orange\n\nBest score: '+best+'\nLevels unlocked: '+unlocked+'/'+MAX,'🎖️','OKAY');else if(k==='Gifts')modal('Free gift','Claim a free life if you have fewer than five. Online purchases and multiplayer are not enabled in this offline version.','🎁',lives<5?'CLAIM LIFE':'OKAY',()=>{if(lives<5){lives++;save();hud()}});else modal('Friends','Your local profile is Candy Explorer. Online friends and multiplayer need a server and are not active in this offline game.','👯','OKAY')});$('shuffle').onclick=()=>{if(!busy&&!paused){make();sel=null;render();$('hint').textContent='Board shuffled! Find a match.'}};$('hintBtn').onclick=hint;$('power').onclick=power;$('sound').onclick=()=>{soundOn=!soundOn;db.set('Sound',soundOn?'on':'off');$('sound').querySelector('span').textContent=soundOn?'🔊':'🔇';tone(650,.08)};$('pause').onclick=()=>{if(busy)return;paused=!paused;$('pause').querySelector('small').textContent=paused?'Resume':'Pause';if(paused)modal('Paused','Your board is waiting for you.','⏸️','RESUME',()=>{paused=false;$('pause').querySelector('small').textContent='Pause'})};function mapUpdate(){$('levelMap').textContent=level;$('stats').textContent=`⭐ Best ${best.toLocaleString()} · 🏰 ${unlocked}/${MAX} levels unlocked`;for(let i=1;i<=5;i++){let n=$('node'+i);n.textContent=i<unlocked?'✓':i===level?i:'🔒';n.style.opacity=i<=unlocked?'1':'.55';n.onclick=()=>i<=unlocked?(level=i,save(),start()):modal('Level locked','Complete your current level to unlock more adventures.','🔒','OKAY')}}function hud(){$('lives').textContent=lives;$('level').textContent=level;$('moves').textContent=moves;$('score').textContent=score;$('goal').textContent=Math.max(0,goal-collected);$('progress').style.width=Math.min(100,collected/Math.max(1,goal)*100)+'%';mapUpdate()}function render(){let el=$('board');el.textContent='';board.forEach((row,r)=>row.forEach((v,c)=>{let b=document.createElement('button');b.className='candy'+(sel&&sel.r===r&&sel.c===c?' sel':'')+(v==='🌈'?' rainbow':v&&typeof v==='object'&&v.special?' special':'');b.textContent=icon(v);b.setAttribute('aria-label',`Row ${r+1}, column ${c+1}, ${icon(v)}`);b.onclick=()=>tap(r,c);el.appendChild(b)}));hud()}function make(){for(let tries=0;tries<80;tries++){board=Array.from({length:N},()=>Array(N).fill(null));for(let r=0;r<N;r++)for(let c=0;c<N;c++){let opts=T.filter(t=>!(c>1&&icon(board[r][c-1])===t&&icon(board[r][c-2])===t)&&!(r>1&&icon(board[r-1][c])===t&&icon(board[r-2][c])===t));board[r][c]=opts[Math.random()*opts.length|0]}if(hasMove())return}board=Array.from({length:N},()=>Array.from({length:N},()=>T[Math.random()*T.length|0]))}function matches(){let s=new Set(),runs=[],special=new Set();for(let r=0;r<N;r++){let c=0;while(c<N){let t=icon(board[r][c]),e=c+1;while(t&&e<N&&icon(board[r][e])===t)e++;if(t&&e-c>=3)runs.push({cells:Array.from({length:e-c},(_,i)=>[r,c+i]),len:e-c});c=e}}for(let c=0;c<N;c++){let r=0;while(r<N){let t=icon(board[r][c]),e=r+1;while(t&&e<N&&icon(board[e][c])===t)e++;if(t&&e-r>=3)runs.push({cells:Array.from({length:e-r},(_,i)=>[r+i,c]),len:e-r});r=e}}for(let run of runs){run.cells.forEach(([r,c])=>s.add(`${r},${c}`));let [r,c]=run.cells[Math.floor(run.cells.length/2)];if(run.len>=5){board[r][c]={icon:'🌈',special:'rainbow'};special.add(`${r},${c}`)}else if(run.len>=4){board[r][c]={icon:'💥',special:'line'};special.add(`${r},${c}`)}}special.forEach(k=>s.delete(k));return s}function hasMove(){let original=board;for(let r=0;r<N;r++)for(let c=0;c<N;c++)for(let[dr,dc]of[[1,0],[0,1]]){let nr=r+dr,nc=c+dc;if(nr>=N||nc>=N)continue;board=JSON.parse(JSON.stringify(original));[board[r][c],board[nr][nc]]=[board[nr][nc],board[r][c]];if(matches().size){board=original;return true}}board=original;return false}function tap(r,c){if(busy||paused)return;if(!sel){sel={r,c};render();return}let a=sel;sel=null;if(Math.abs(a.r-r)+Math.abs(a.c-c)!==1){sel={r,c};render();return}swap(a,{r,c})}async function swap(a,b){if(busy||paused)return;busy=true;let id=round,va=board[a.r][a.c],vb=board[b.r][b.c],sa=va&&typeof va==='object'&&va.special,sb=vb&&typeof vb==='object'&&vb.special;[board[a.r][a.c],board[b.r][b.c]]=[board[b.r][b.c],board[a.r][a.c]];let m;if(sa||sb){m=new Set();if(sa&&sb){for(let r=0;r<N;r++)for(let c=0;c<N;c++)m.add(`${r},${c}`)}else{let sp=sa?va:vb,pos=sa?b:a,target=icon(sa?vb:va);m.add(`${pos.r},${pos.c}`);if(sp.special==='line'){for(let i=0;i<N;i++){m.add(`${pos.r},${i}`);m.add(`${i},${pos.c}`)}}else{if(T.includes(target)){for(let r=0;r<N;r++)for(let c=0;c<N;c++)if(icon(board[r][c])===target)m.add(`${r},${c}`)}else for(let r=0;r<N;r++)for(let c=0;c<N;c++)if(T.includes(icon(board[r][c])))m.add(`${r},${c}`)}}}else{m=matches();if(!m.size){[board[a.r][a.c],board[b.r][b.c]]=[board[b.r][b.c],board[a.r][a.c]];busy=false;render();$('hint').textContent='No match there — try another swap!';return}}moves--;await clear(m);if(id!==round)return;busy=false;render();if(endCheck())return;if(!hasMove()){make();render();$('hint').textContent='No moves left — board refreshed!'}else $('hint').textContent=`Sweet! ${Math.max(0,goal-collected)} more candies to collect.`}async function clear(m){let loops=0;while(m.size&&loops++<25){let ex=new Set(m);for(let k of m){let[r,c]=k.split(',').map(Number),v=board[r][c];if(!v||typeof v!=='object')continue;if(v.special==='line'){for(let i=0;i<N;i++){ex.add(`${r},${i}`);ex.add(`${i},${c}`)}}else if(v.special==='rainbow'){let counts={};board.flat().forEach(x=>{let q=icon(x);if(T.includes(q))counts[q]=(counts[q]||0)+1});let target=Object.keys(counts).sort((a,b)=>counts[b]-counts[a])[0];if(target)for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(icon(board[y][x])===target)ex.add(`${y},${x}`)}}let actual=[...ex].filter(k=>{let[r,c]=k.split(',').map(Number);return board[r][c]!=null});if(!actual.length)break;collected+=actual.length;score+=actual.length*60;tone(530+Math.min(600,actual.length*18));actual.forEach(k=>{let[r,c]=k.split(',').map(Number);board[r][c]=null});render();await sleep(90);for(let c=0;c<N;c++){let col=board.map(row=>row[c]).filter(v=>v!=null);while(col.length<N)col.unshift(T[Math.random()*T.length|0]);for(let r=0;r<N;r++)board[r][c]=col[r]}m=matches();if(m.size)await sleep(50)}best=Math.max(best,score);save()}function endCheck(){if(collected>=goal){unlocked=Math.max(unlocked,Math.min(MAX,level+1));level=Math.min(MAX,level+1);save();mapUpdate();modal('Level complete!',`Amazing! Score: ${score.toLocaleString()}\nBest score: ${best.toLocaleString()}\nNext level unlocked!`,'🏆','NEXT LEVEL ▶',start);return true}if(moves<=0){lives=Math.max(0,lives-1);save();hud();modal('Out of moves!',`You collected ${collected} of ${goal}. ${lives?'One life used. Try again!':'No extra lives remain, but you can still retry.'}`,'💫','TRY AGAIN',start);return true}return false}function start(){round++;level=Math.max(1,Math.min(MAX,level));moves=Math.max(18,26-Math.floor(level/5));score=0;goal=18+(level-1)*4;collected=0;sel=null;busy=false;paused=false;$('pause').querySelector('small').textContent='Pause';$('map').classList.add('hidden');$('game').classList.remove('hidden');make();render();$('hint').textContent='Tap a candy, then an adjacent candy to swap.'}async function power(){if(busy||paused||moves<=0)return;busy=true;let id=round;moves--;let r=Math.random()*N|0;await clear(new Set(Array.from({length:N},(_,c)=>`${r},${c}`)));if(id!==round)return;busy=false;render();if(endCheck())return;if(!hasMove()){make();render()}$('hint').textContent='Power blast! Keep matching!'}function hint(){if(busy||paused)return;let original=board;for(let r=0;r<N;r++)for(let c=0;c<N;c++)for(let[dr,dc]of[[1,0],[0,1]]){let nr=r+dr,nc=c+dc;if(nr>=N||nc>=N)continue;board=JSON.parse(JSON.stringify(original));[board[r][c],board[nr][nc]]=[board[nr][nc],board[r][c]];if(matches().size){board=original;sel={r,c};render();$('hint').textContent='Try the highlighted candy!';return}}board=original;make();render();$('hint').textContent='Board refreshed — find a match!'}make();render();mapUpdate()})();
</script></body></html>