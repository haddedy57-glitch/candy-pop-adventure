.legend{text-align:center;font-size:11px;font-weight:800;color:#774b9b;margin:10px 0 0}.candy.special{outline:3px solid #fff9a6;box-shadow:inset 0 -4px #542c4b25,0 0 9px #fff46b}.candy.rainbow{background:conic-gradient(#ff4f9b,#ffbd39,#fff65d,#55e78c,#48d7ff,#ad7aff,#ff4f9b);border:2px solid white}.nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(100%,520px);height:74px;display:flex;background:linear-gradient(#ff9bd0,#ff69b4);border-top:4px solid #fff0fa;z-index:3}.nav button{flex:1;border:0;border-right:1px solid #ffffff55;background:transparent;color:#8b2b68;font-weight:900;display:flex;flex-direction:column;align-items:center;justify-content:center}.nav span{font-size:24px}.nav small{font-size:10px}.hidden{display:none!important}.modal{position:fixed;inset:0;z-index:9;background:#24113bbd;display:grid;place-items:center;padding:20px}.card{position:relative;width:min(100%,350px);text-align:center;background:linear-gradient(#fffaf5,#ffe7f4);border:7px solid #ff82c4;border-radius:30px;padding:24px 18px;box-shadow:0 8px #b63783}.card h2{margin:5px 0;color:#a32d76}.card p{color:#79465f;line-height:1.5}.card .emoji{font-size:52px}.close{position:absolute;right:-13px;top:-16px;border:3px solid white;border-radius:50%;width:40px;height:40px;background:#ff4f63;color:white;font-size:25px}
</style></head><body><div class="app">
<header class="top"><div class="pill">💗 <span id="lives">5</span> ＋</div><div class="brand">🍭 CANDY POP<small>ADVENTURE · EPIC EDITION</small></div><button class="round" id="settings">⚙</button></header>
<main id="map" class="screen map"><div class="castle">🏰</div><section class="world"><div class="island i1">🍬<br>🏡</div><div class="island i2">🍭<br>🏠</div><svg class="path" viewBox="0 0 340 570" preserveAspectRatio="none"><path d="M168 540 C80 500 240 455 155 410 S90 330 180 285 S260 205 150 165 S110 90 170 35"/><path class="pink" d="M168 540 C80 500 240 455 155 410 S90 330 180 285 S260 205 150 165 S110 90 170 35"/></svg><div class="node n1" id="node1">✓</div><div class="node n2" id="node2">✓</div><div class="node n3" id="node3">3</div><div class="node n4" id="node4">4</div><div class="node n5" id="node5">5</div><div class="mascot">🍓</div></section><section class="caption"><h1>Sugarland Island</h1><p>Every sweet has a story!</p><button class="primary" id="play">PLAY LEVEL <span id="levelMap">3</span> ▶</button></section></main>
<main id="game" class="screen game hidden"><div class="heading"><button class="round" id="back">‹</button><div><small>LEVEL <span id="level">3</span></small><h2>Collect the candy!</h2></div><div class="box"><small>MOVES</small><strong id="moves">25</strong></div></div><div class="goal"><span class="emoji">🍬</span><div><b>Sweet collection</b><small>Collect <span id="goal">20</span> candies</small></div><div class="box"><small>SCORE</small><strong id="score">0</strong></div></div><div class="boardwrap"><div id="board" class="board"></div></div><div id="hint" class="hint">Tap a candy, then an adjacent candy to swap.</div><div class="boost"><button id="shuffle"><span>🔀</span><small>Shuffle</small></button><button id="hintBtn"><span>💡</span><small>Hint</small></button><button id="powerBtn"><span>💥</span><small>Power</small></button><button id="soundBtn"><span>🔊</span><small>Sound</small></button><button id="pause"><span>Ⅱ</span><small>Pause</small></button></div><p class="legend">✨ Match 4 for a line blast · 🌈 Match 5 for a rainbow candy</p></main>
