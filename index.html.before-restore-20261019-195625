<script>
(()=>{const $=id=>document.getElementById(id),T=["🍓","🍋","🍇","🍬","🫐","🍊"],N=8;let board=[],sel=null,moves=25,score=0,goal=20,collected=0,level=+(localStorage.cpaLevel||1),busy=false,paused=false,lives=+(localStorage.cpaLives||5),soundOn=localStorage.cpaSound!=="off",best=+(localStorage.cpaBest||0),unlocked=Math.max(1,+(localStorage.cpaLevel||1));
$("lives").textContent=lives;$("levelMap").textContent=level;$("soundBtn").querySelector("span").textContent=soundOn?"🔊":"🔇";updateMap();const sleep=n=>new Promise(r=>setTimeout(r,n));function modal(t,p,e,a,fn){$("modalTitle").textContent=t;$("modalText").textContent=p;$("modalEmoji").textContent=e;$("modalAction").textContent=a;$("modal").classList.remove("hidden");$("modalAction").onclick=()=>{$("modal").classList.add("hidden");fn()}}$("close").onclick=()=>{$("modal").classList.add("hidden");if(paused){paused=false;$("pause").querySelector("small").textContent="Pause"}};$("settings").onclick=()=>modal("Settings",`Sound: ${soundOn?"ON":"OFF"}. Progress and best score are saved on this device. Use the Sound button in a level to change audio.`,"⚙️","OKAY",()=>{});$("play").onclick=start;$("back").onclick=()=>$("game").classList.add("hidden")||$("map").classList.remove("hidden");$("navMap").onclick=()=>{$("game").classList.add("hidden");$("map").classList.remove("hidden")};document.querySelectorAll("[data-info]").forEach(b=>b.onclick=()=>{const k=b.dataset.info;if(k==="Goals")modal("Goals",`Level ${level}: collect ${goal} candies. Current progress: ${collected}/${goal}. Best score: ${best}.`,"📋","OKAY",()=>{});else if(k==="Collection")modal("Candy Collection",`🍓 Strawberry · 🍋 Lemon · 🍇 Grape · 🍬 Sweet · 🫐 Berry · 🍊 Orange\n\nBest score: ${best}\nLevels unlocked: ${unlocked}/30`,"🎖️","OKAY",()=>{});else if(k==="Shop")modal("Candy Shop","Free daily gift: tap OK to claim one extra life (up to 5). No real-money purchases.","🛍️","CLAIM LIFE",()=>{lives=Math.min(5,lives+1);localStorage.cpaLives=lives;$ ("lives").textContent=lives;});else modal("Friends","Local player profile: Candy Explorer. Multiplayer and friend invites need an online server, so they are not active in this offline edition.","👯","OKAY",()=>{})});$("shuffle").onclick=()=>{if(!busy){make();render();$("hint").textContent="Board shuffled! Find a match."}};$("hintBtn").onclick=hint;$("powerBtn").onclick=powerMove;$("soundBtn").onclick=()=>{soundOn=!soundOn;localStorage.cpaSound=soundOn?"on":"off";$("soundBtn").querySelector("span").textContent=soundOn?"🔊":"🔇";tone(660,.08)};$("pause").onclick=()=>{paused=!paused;$("pause").querySelector("small").textContent=paused?"Resume":"Pause";if(paused)modal("Paused","Take a sweet break.","⏸️","RESUME",()=>{paused=false;$("pause").querySelector("small").textContent="Pause"})};
function tone(freq=520,duration=.08){if(!soundOn)return;try{const C=window.AudioContext||window.webkitAudioContext;if(!C)return;const ctx=new C(),o=ctx.createOscillator(),g=ctx.createGain();o.type="sine";o.frequency.value=freq;g.gain.value=.035;o.connect(g);g.connect(ctx.destination);o.start();o.stop(ctx.currentTime+duration);o.onended=()=>ctx.close()}catch(e){}}function make(){let tries=0;do{board=Array.from({length:N},()=>Array(N).fill(null));for(let r=0;r<N;r++)for(let c=0;c<N;c++){let opts=T.filter(t=>!(c>1&&iconOf(board[r][c-1])===t&&iconOf(board[r][c-2])===t)&&!(r>1&&iconOf(board[r-1][c])===t&&iconOf(board[r-2][c])===t));board[r][c]=opts[Math.random()*opts.length|0]}tries++}while((matches().size||!hasMove())&&tries<200);if(matches().size){for(let r=0;r<N;r++)for(let c=0;c<N;c++)board[r][c]=T[Math.random()*T.length|0];makeCleanFallback()}}
function hasMove(){for(let r=0;r<N;r++)for(let c=0;c<N;c++)for(const [dr,dc] of [[1,0],[0,1]]){const nr=r+dr,nc=c+dc;if(nr>=N||nc>=N)continue;[board[r][c],board[nr][nc]]=[board[nr][nc],board[r][c]];const yes=matches().size>0;[board[r][c],board[nr][nc]]=[board[nr][nc],board[r][c]];if(yes)return true}return false}
function makeCleanFallback(){for(let r=0;r<N;r++)for(let c=0;c<N;c++){let opts=T.filter(t=>!(c>1&&iconOf(board[r][c-1])===t&&iconOf(board[r][c-2])===t)&&!(r>1&&iconOf(board[r-1][c])===t&&iconOf(board[r-2][c])===t));board[r][c]=opts[Math.random()*opts.length|0]}}
function updateMap(){ $("levelMap").textContent=level; for(let i=1;i<=5;i++){const n=$("node"+i);if(n){n.textContent=i<unlocked?"✓":i===level?String(i):"🔒";n.style.opacity=i<=unlocked?"1":".55";n.onclick=()=>{if(i<=unlocked){level=i;localStorage.cpaLevel=level;$ ("levelMap").textContent=level;start()}else modal("Level locked","Complete the previous level to unlock this one.","🔒","OKAY",()=>{})}}}}
function render(){let el=$("board");el.innerHTML="";board.forEach((row,r)=>row.forEach((v,c)=>{let b=document.createElement("button");b.className="candy"+(sel&&sel.r===r&&sel.c===c?" sel":"")+(v==="🌈"?" rainbow":(v&&v.special?" special":""));b.textContent=v?(typeof v==="string"?v:v.icon):"";b.setAttribute("aria-label",`row ${r+1} column ${c+1} ${v?(typeof v==="string"?v:v.icon):"empty"}`);b.onclick=()=>tap(r,c);el.append(b)}));$("moves").textContent=moves;$("score").textContent=score;$("goal").textContent=Math.max(0,goal-collected)}
function iconOf(v){return typeof v==="string"?v:(v&&v.icon)||""}
function matches(){const s=new Set();for(let r=0;r<N;r++){let c=0;while(c<N){const t=iconOf(board[r][c]);let e=c+1;while(t&&e<N&&iconOf(board[r][e])===t)e++;if(t&&e-c>=3)for(let x=c;x<e;x++)s.add(`${r},${x}`);c=e}}for(let c=0;c<N;c++){let r=0;while(r<N){const t=iconOf(board[r][c]);let e=r+1;while(t&&e<N&&iconOf(board[e][c])===t)e++;if(t&&e-r>=3)for(let y=r;y<e;y++)s.add(`${y},${c}`);r=e}}return s}
function tap(r,c){if(busy||paused)return;if(!sel){sel={r,c};render();return}let a=sel;sel=null;if(Math.abs(a.r-r)+Math.abs(a.c-c)!==1){sel={r,c};render();return}swap(a,{r,c})}
async function swap(a,b){busy=true;[board[a.r][a.c],board[b.r][b.c]]=[board[b.r][b.c],board[a.r][a.c]];let m=matches();if(!m.size){[board[a.r][a.c],board[b.r][b.c]]=[board[b.r][b.c],board[a.r][a.c]];busy=false;render();$("hint").textContent="No match there—try another swap!";return}moves--;await clear(m);busy=false;if(!hasMove())make();render();if(collected>=goal){unlocked=Math.max(unlocked,Math.min(30,level+1));level=Math.min(30,level+1);localStorage.cpaLevel=level;localStorage.cpaUnlocked=unlocked;updateMap();modal("Level complete!",`Amazing! You scored ${score.toLocaleString()} points and earned 3 stars. Best score: ${best.toLocaleString()}.`,"🏆","NEXT LEVEL ▶",start)}else if(moves<=0){lives=Math.max(0,lives-1);localStorage.cpaLives=lives;$("lives").textContent=lives;modal("Out of moves!",`You collected ${collected} of ${goal}. Try again!`,"💫","TRY AGAIN",start)}else $("hint").textContent=`Sweet! ${goal-collected} more candies to collect.`}
async function clear(m){let safety=0;while(m.size&&safety++<20){const expanded=new Set(m);for(const key of m){const [r,c]=key.split(",").map(Number),v=board[r][c];if(v&&typeof v==="object"&&v.special==="line"){for(let x=0;x<N;x++){expanded.add(`${r},${x}`);expanded.add(`${x},${c}`)}}else if(v&&typeof v==="object"&&v.special==="rainbow"){const target=iconOf(board[(r+1)%N][c]);for(let y=0;y<N;y++)for(let x=0;x<N;x++)if(iconOf(board[y][x])===target)expanded.add(`${y},${x}`)}}m=expanded;const actual=[...m].filter(key=>{const [r,c]=key.split(",").map(Number);return !!board[r][c]});collected+=actual.length;score+=actual.length*60;tone(540+Math.min(600,actual.length*18),.06);actual.forEach(key=>{let[r,c]=key.split(",").map(Number);board[r][c]=null});render();await sleep(120);for(let c=0;c<N;c++){let col=board.map(row=>row[c]).filter(Boolean);while(col.length<N)col.unshift(T[Math.random()*T.length|0]);for(let r=0;r<N;r++)board[r][c]=col[r]}m=matches();if(m.size)await sleep(80)}best=Math.max(best,score);localStorage.cpaBest=best}
function start(){level=Math.min(30,Math.max(1,level));moves=Math.max(18,26-Math.floor(level/5));score=0;goal=18+Math.max(0,level-1)*4;collected=0;sel=null;busy=false;paused=false;$("level").textContent=level;$("pause").querySelector("small").textContent="Pause";$("map").classList.add("hidden");$("game").classList.remove("hidden");make();render();$("hint").textContent="Tap a candy, then an adjacent candy to swap."}
async function powerMove(){if(busy||paused||moves<=0)return;busy=true;moves--;const r=Math.random()*N|0;const m=new Set(Array.from({length:N},(_,c)=>`${r},${c}`));tone(300,.15);await clear(m);busy=false;if(!hasMove())make();render();if(collected>=goal){unlocked=Math.max(unlocked,Math.min(30,level+1));level=Math.min(30,level+1);localStorage.cpaLevel=level;localStorage.cpaUnlocked=unlocked;updateMap();modal("Level complete!",`Power move! You scored ${score.toLocaleString()} points.`,"🏆","NEXT LEVEL ▶",start)}else if(moves<=0){modal("Out of moves!","Try the level again.","💫","TRY AGAIN",start)}}function hint(){if(busy||paused)return;for(let r=0;r<N;r++)for(let c=0;c<N;c++)for(let[dr,dc]of[[1,0],[0,1]]){let nr=r+dr,nc=c+dc;if(nr>=N||nc>=N)continue;[board[r][c],board[nr][nc]]=[board[nr][nc],board[r][c]];let yes=matches().size>0;[board[r][c],board[nr][nc]]=[board[nr][nc],board[r][c]];if(yes){sel={r,c};render();$("hint").textContent="Try the highlighted candy!";return}}$("hint").textContent="Try shuffling the board."}
make();render()})();
</script><script>if("serviceWorker" in navigator && location.protocol!=="file:"){window.addEventListener("load",()=>navigator.serviceWorker.register("./sw.js").catch(()=>{}))}</script></body></html>